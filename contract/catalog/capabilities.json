  "mcpRiskLabels": {
    "read": "{server}: read-only tools",
    "write": "{server}: tools that create or change data",
    "external": "{server}: tools that send or publish",
    "destructive": "{server}: tools that delete",
    "execute": "{server}: tools that run code or are not recognised",
    "admin": "{server}: tools that change settings or permissions"
