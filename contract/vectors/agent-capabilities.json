{
  "$schema": "https://lumoauth.dev/schemas/sdk-contract/vectors-1.json",
  "description": "How an agent capability (an agent's OAuth scope value) is matched, exactly as the server does it (server/src/Security/AgentCapability.php). The canonical form is <resource>:<action>, for example invoices:read. normalize: trim the characters space, tab, LF, CR, NUL and vertical tab from both ends; lower-case ASCII letters only (A-Z, as PHP's strtolower; other letters are kept); replace '.' with ':'; collapse runs of ':' into one; trim ':' from both ends. A '-' is part of a name and is kept. covers(capability, action): normalize both; false if either is empty; true if the capability is '*' or equals the action; true if the capability ends in ':*' and the action starts with the capability minus its final '*'; false otherwise. any_covers(list, action): true if any entry covers the action. scripts/check-capability-vectors.py runs every case against the server's class. Until 2026-11-18 the separator was '.' and '-' was folded into it.",
  "normalize": [
    { "input": "invoices:read", "expected": "invoices:read" },
    { "input": "invoices.read", "expected": "invoices:read" },
    { "input": "Invoices:Read", "expected": "invoices:read" },
    { "input": "Invoices.Read", "expected": "invoices:read" },
    { "input": "invoices-read", "expected": "invoices-read" },
    { "input": "  invoices:read  ", "expected": "invoices:read" },
    { "input": "\tinvoices:read\n", "expected": "invoices:read" },
    { "input": "invoices::read", "expected": "invoices:read" },
    { "input": "invoices.:read", "expected": "invoices:read" },
    { "input": "invoices:-read", "expected": "invoices:-read" },
    { "input": ":invoices:read:", "expected": "invoices:read" },
    { "input": ".invoices.read.", "expected": "invoices:read" },
    { "input": "read:*", "expected": "read:*" },
    { "input": "read.*", "expected": "read:*" },
    { "input": "USERS-DATA.*", "expected": "users-data:*" },
    { "input": "financial_reports:read", "expected": "financial_reports:read" },
    { "input": "clients.rotate-secret", "expected": "clients:rotate-secret" },
    { "input": "pull-requests:comment", "expected": "pull-requests:comment" },
    { "input": "admin:agents:write", "expected": "admin:agents:write" },
    { "input": "users.delete.hard", "expected": "users:delete:hard" },
    { "input": "*", "expected": "*" },
    { "input": ":*", "expected": "*" },
    { "input": ".*", "expected": "*" },
    { "input": "users:**", "expected": "users:**" },
    { "input": "Ünits:Read", "expected": "Ünits:read" },
    { "input": "", "expected": "" },
    { "input": "   ", "expected": "" },
    { "input": ":", "expected": "" },
    { "input": ".", "expected": "" }
  ],
  "covers": [
    { "capability": "invoices:read", "action": "invoices:read", "expected": true },
    { "capability": "invoices:read", "action": "Invoices:Read", "expected": true },
    { "capability": "invoices:read", "action": "invoices.read", "expected": true },
    { "capability": "Invoices.Read", "action": "invoices:read", "expected": true },
    { "capability": "invoices:read", "action": "invoices-read", "expected": false },
    { "capability": "financial_reports:read", "action": "financial_reports.read", "expected": true },
    { "capability": "invoices:read", "action": "invoices:read:draft", "expected": false },
    { "capability": "invoices:read", "action": "invoices:write", "expected": false },
    { "capability": "invoices:*", "action": "invoices:read", "expected": true },
    { "capability": "invoices:*", "action": "invoices.read", "expected": true },
    { "capability": "invoices.*", "action": "invoices:read", "expected": true },
    { "capability": "invoices:*", "action": "invoices:read:draft", "expected": true },
    { "capability": "invoices:*", "action": "invoices", "expected": false },
    { "capability": "invoices:*", "action": "invoicesarchive:read", "expected": false },
    { "capability": "invoices:*", "action": "invoices-archive:read", "expected": false },
    { "capability": "invoices-archive:*", "action": "invoices-archive:read", "expected": true },
    { "capability": "invoices:*", "action": "payments:read", "expected": false },
    { "capability": "invoices:*", "action": "invoices:*", "expected": true },
    { "capability": "users:*", "action": "USERS:DELETE", "expected": true },
    { "capability": "users:*", "action": "users-delete", "expected": false },
    { "capability": "clients:rotate-secret", "action": "clients.rotate-secret", "expected": true },
    { "capability": "*", "action": "anything:at:all", "expected": true },
    { "capability": ":*", "action": "users:delete", "expected": true },
    { "capability": "*:read", "action": "invoices:read", "expected": false },
    { "capability": "*:read", "action": "*:read", "expected": true },
    { "capability": "invoices:re*", "action": "invoices:read", "expected": false },
    { "capability": "users:**", "action": "users:delete", "expected": false },
    { "capability": "", "action": "invoices:read", "expected": false },
    { "capability": "*", "action": "", "expected": false },
    { "capability": "*", "action": " : ", "expected": false }
  ],
  "any_covers": [
    { "capabilities": ["tickets:read", "tickets:reply"], "action": "tickets:reply", "expected": true },
    { "capabilities": ["tickets:read", "tickets:reply"], "action": "refunds:issue", "expected": false },
    { "capabilities": ["tickets:read", "invoices:*"], "action": "Invoices.Approve", "expected": true },
    { "capabilities": [], "action": "tickets:read", "expected": false }
  ]
}
