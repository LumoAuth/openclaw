{
  "description": "SPEC §6.1: the decision for one call, before any approval channel is used. Input: the classification (only the fields that matter), the hard-rule result, and the state. Output: outcome ('allow', 'block', 'approve') and reason code. Receipt decision for a block: 'blocked' for reasons locked, not_set_up, hard_rule, snapshot_unavailable, agent_inactive; 'denied' for not_granted and approvals_off. Defaults: config = SPEC §3.1 defaults; state.locked=false, state.setUp=true, snapshot = {status:'active', ageSeconds: 10, capabilities: []}, tainted=false.",
  "reasons": {
    "locked": "Locked by the owner",
    "not_set_up": "LumoAuth Guard is not set up",
    "hard_rule": "Protected by a rule that cannot be changed",
    "hard_rule_approve": "Touches something protected",
    "snapshot_unavailable": "LumoAuth cannot confirm this agent's permissions",
    "agent_inactive": "The agent is not active in LumoAuth",
    "granted": "Granted",
    "tainted": "After the agent read untrusted content",
    "not_granted": "Not granted to this agent",
    "approvals_off": "Needs approval, and approvals are switched off"
  },
